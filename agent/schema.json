{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppResearchRecord",
  "type": "object",
  "required": ["id", "app", "category", "one_liner", "auth_methods", "toolkit_auth", "access", "api_type", "api_breadth", "official_mcp", "verdict", "blocker", "evidence", "confidence"],
  "properties": {
    "id": {"type": "integer"},
    "app": {"type": "string"},
    "category": {"type": "string"},
    "subcategory": {"type": "string", "description": "e.g. 'helpdesk', 'payments', 'web scraping'"},
    "one_liner": {"type": "string"},
    "docs_url": {"type": "string"},
    "auth_methods": {"type": "array", "items": {"enum": ["oauth2", "api_key", "bearer_token", "basic", "jwt_signed", "none", "other", "unknown"]}},
    "toolkit_auth": {"enum": ["oauth2", "api_key", "bearer_token", "basic", "jwt_signed", "none", "other", "unknown"]},
    "auth_notes": {"type": "string"},
    "access": {"enum": ["self_serve_free", "self_serve_trial", "paid_plan", "app_review", "partner_gated", "unknown"]},
    "gate_evidence": {"type": "string"},
    "api_type": {"type": "array", "items": {"enum": ["rest", "graphql", "soap", "rpc", "websocket", "cli", "sdk_only", "none"]}},
    "api_breadth": {"enum": ["broad", "moderate", "narrow", "none", "unknown"]},
    "webhooks": {"enum": ["yes", "no", "unknown"]},
    "sandbox": {"enum": ["yes", "no", "unknown"]},
    "official_mcp": {"enum": ["yes", "no", "unknown"]},
    "mcp_url": {"type": "string"},
    "community_mcp": {"type": "string"},
    "verdict": {"enum": ["ready", "ready_with_friction", "blocked"]},
    "blocker": {"type": "string"},
    "blocker_type": {"enum": ["none", "app_review", "paid_plan", "partner_gate", "no_public_api", "per_tenant_setup", "not_a_saas_api", "other"]},
    "toolkit_shape": {"enum": ["mcp_server", "agent_skills", "cli_wrapper", "wait_for_partner"]},
    "evidence": {"type": "array", "items": {"type": "object", "properties": {"claim": {"type": "string"}, "url": {"type": "string"}}}},
    "evidence_quality": {"enum": ["primary", "secondary", "none"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "needs_human": {"type": "boolean"},
    "notes": {"type": "string"}
  }
}
